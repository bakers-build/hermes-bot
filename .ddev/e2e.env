# The variables of the end-to-end stack in ddev (docker-compose.e2e.yaml), as run.sh sets them.
PM_BOT_IMAGE=pm-bot:e2e
PM_BOT_DATA=./tests/e2e/ddev-out/data
PM_BOT_CLONE=./tests/e2e/ddev-out/clone
PM_BOT_UID=${DDEV_UID}
PM_BOT_GID=${DDEV_GID}
E2E_AGENT=./tests/e2e/ddev-out/agent
E2E_CONDUCTOR=./tests/e2e/ddev-out/conductor
# Claude Code works the tickets, with the key from .env.e2e; stub plays tests/e2e/agent scripts.
E2E_CONDUCTOR_AGENT=claude
E2E_SITE_HOST=hermes-bot.ddev.site
