# The local Hermes WebUI look (webui/compose.yaml, README.md › Look at it in Hermes WebUI).
# Copy to webui/.env and fill in. Docker Compose reads the first block for the compose file;
# the containers get every key. For this machine only. webui/register-client.sh fills the bakers.build
# and sign-in values from the end-to-end test's site.

# The compose file's own values.
# The bot image the look runs; after changing or pulling it: docker compose -f webui/compose.yaml down -v.
PM_BOT_IMAGE=ghcr.io/bakers-build/hermes-bot:main
# A clone of the project's repository, mounted read-only (absolute path).
PM_BOT_CLONE=/path/to/a/clone/of/the/project
# Apple silicon: the bot image is amd64 only.
#DOCKER_DEFAULT_PLATFORM=linux/amd64

# The web UI's users: each one's bakers.build e-mail address and own profile (lowercase letters,
# digits, - and _). Anyone else who signs in lands in the profile default.
WEBUI_USERS=owner@example.test=owner,requester@example.test=requester
# Sign-in at bakers.build, written by webui/register-client.sh: the client, a cookie secret, and
# WEBUI_USERS by bakers.build user ID, the one thing the site tells the proxy about a user.
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
HERMES_WEBUI_GROUP_PROFILE_MAP=

# The bot's env, as in .env.example.
HERMES_HOME=/opt/data
PM_BOT_CLONE_DIR=/opt/clone
# Model: an Anthropic API key or a Claude subscription token, exactly one.
PM_BOT_MODEL=claude-sonnet-5-5
PM_BOT_MODEL_BASE_URL=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
PM_BOT_LANGUAGE=de
# bakers.build: the end-to-end test's site, its bot key and project (webui/register-client.sh).
BAKERS_URL=http://nginx
BAKERS_API_KEY=
PM_BOT_PROJECT=
PM_BOT_TICKET_WORKFLOW=bb_work
PM_BOT_CONDUCTOR=
# No nightly audit job in the look's Hermes home.
AUDIT_ENABLED=false
TZ=Europe/Berlin

# Slack: inert. `entrypoint.sh check` requires the keys; nothing connects to Slack.
SLACK_BOT_TOKEN=xoxb-inert
SLACK_APP_TOKEN=xapp-inert
SLACK_ALLOWED_CHANNELS=C0000000000
SLACK_ADMIN_USERS=U0000000000
SLACK_WORKSPACE_URL=https://slack.invalid
