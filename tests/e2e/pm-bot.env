# The pm-bot's env file in the end-to-end test: every key of .env.example (the contract checks it),
# no Slack tokens and fake Slack IDs. run.sh fills each value `@…@` from the seed and the run's
# options and writes the result to the data directory's .env. Nothing here is a credential.
HERMES_HOME=/opt/data
PM_BOT_CLONE_DIR=/opt/clone
PM_BOT_MODEL=claude-sonnet-5-5
PM_BOT_LANGUAGE=de
PM_BOT_MODEL_BASE_URL=@PM_BOT_MODEL_BASE_URL@
ANTHROPIC_API_KEY=@ANTHROPIC_API_KEY@
CLAUDE_CODE_OAUTH_TOKEN=@CLAUDE_CODE_OAUTH_TOKEN@
BAKERS_URL=@BAKERS_URL@
BAKERS_API_KEY=@BAKERS_API_KEY@
PM_BOT_PROJECT=@PM_BOT_PROJECT@
PM_BOT_TICKET_WORKFLOW=bb_work
PM_BOT_CONDUCTOR=@PM_BOT_CONDUCTOR@
# One pass per two seconds keeps a scenario short.
PM_BOT_POLL_INTERVAL=2
PM_BOT_HEARTBEAT_INTERVAL=1800
PREVIEW_ZONES=
# The nightly audit is registered as in production; the audit scenario runs it itself.
AUDIT_ENABLED=true
AUDIT_TIME=03:30
TZ=UTC
# No Slack tokens: `hermes chat` starts Hermes' gateway, which would connect to Slack with them.
# The poller gets an inert token from mode agent (entrypoint.sh).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_CHANNELS=C0E2EMAIN
SLACK_ALLOWED_USERS=
GATEWAY_ALLOW_ALL_USERS=true
SLACK_ADMIN_USERS=U0E2EADMIN
SLACK_HOME_CHANNEL=
SLACK_WORKSPACE_URL=https://e2e.slack.com
# Not in .env.example: the poller's Slack calls go to the recorder.
SLACK_API_URL=http://slack-recorder/api
