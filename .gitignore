/.env
# bakers.build: transient agent evidence (screenshots, logs) of a ticket run — never committed.
/assets-ai/
# bakers.build: machine-local overrides and runtime files beside the committed project config.
*.config.local.js
/.bakers/log.txt
/.bakers/ui-refresh
/.bakers/*.frozen.json
/.bakers-worktrees/
/.bakers/*.bootstrapped.json
# The end-to-end test's run directory: the stack's data, seed keys and failure logs.
/tests/e2e/out/
# The local Hermes WebUI look (webui/): its env file.
/webui/.env
