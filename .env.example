# The keys the PM bot's container reads from its env file, /opt/data/.env (on the workspace:
# ~/.pm-bot/data/.env). The Coder workspace template writes the file from its workspace
# parameters on every start (README.md); edits to it are lost.
# The values below are examples, not defaults.

# Hermes' home inside the container, and the read-only clone the clone-reader sees.
HERMES_HOME=/opt/data
PM_BOT_CLONE_DIR=/opt/clone

# Model. An Anthropic API key, or a Claude subscription token (`claude setup-token`) for
# tests. Exactly one of the two.
PM_BOT_MODEL=claude-sonnet-5-5
# Optional. The Anthropic Messages endpoint (default https://api.anthropic.com); the end-to-end
# test points it at its scripted model.
PM_BOT_MODEL_BASE_URL=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Optional. The bot's language, an ISO 639-1 code (default de). The plugin's and the poller's
# own texts exist in German and English; for any other code they stay German while the persona
# answers in that language. A value that is no code logs an error and keeps German.
PM_BOT_LANGUAGE=de

# bakers.build: the server, and the API key of the bot's service account, sent as the bearer on
# its /mcp. Hermes reads it from this file; it never lands in config.yaml.
BAKERS_URL=https://bakers.example.com
BAKERS_API_KEY=
# The project's UUID; every ticket the bot creates goes there.
PM_BOT_PROJECT=00000000-0000-4000-8000-000000000000
# Workflow of the tickets the bot creates (default bb_work).
PM_BOT_TICKET_WORKFLOW=bb_work
# The conductor (UUID) set on each new ticket. Empty: tickets wait until someone sets one.
PM_BOT_CONDUCTOR=
# Optional. Seconds between two polls (default 15).
PM_BOT_POLL_INTERVAL=15
# Optional. Seconds of silence in a conversation before a working ticket gets a
# "still working on it" line (default 1800).
PM_BOT_HEARTBEAT_INTERVAL=1800
# Optional. Comma list of DNS zones whose hosts serve worktree previews, e.g.
# preview.keytec.de: a summary's Manual review link on <label>.<zone> is posted
# into the ticket's channel. Empty: no summary link is posted.
PREVIEW_ZONES=

# Optional. The nightly Composer audit of the clone (README.md › The nightly Composer audit):
# on unless false (or 0, no, off), at AUDIT_TIME (HH:MM, default 03:30) in the time zone TZ (default UTC).
AUDIT_ENABLED=true
AUDIT_TIME=03:30
TZ=Europe/Berlin

# The bot's side, where requesters talk to it: slack (default) or gitlab (README.md › Sides).
# Only the chosen side's keys below are required.
PM_BOT_CHAT=slack

# GitLab issues (PM_BOT_CHAT=gitlab; README.md › The GitLab side). The instance, the project's
# path, and a project access token of the bot with role Maintainer and scope api: it reads and
# writes the project's issues and notes and keeps its own project webhook.
GITLAB_URL=https://gitlab.example.com
GITLAB_PROJECT=group/project
GITLAB_TOKEN=
# The public HTTPS URL GitLab posts the issue and note events to; it must reach the container's
# GITLAB_WEBHOOK_PORT (default 8080) at the path /webhooks/gitlab.
GITLAB_WEBHOOK_URL=https://pm-bot.example.com/webhooks/gitlab
GITLAB_WEBHOOK_PORT=8080

# Slack app in Socket Mode (PM_BOT_CHAT=slack).
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Comma-separated channel IDs the bot answers in. Messages elsewhere are ignored.
SLACK_ALLOWED_CHANNELS=C0000000001
# Optional comma-separated member IDs. Empty: every user in the allowed channels, and the
# file carries GATEWAY_ALLOW_ALL_USERS=true.
SLACK_ALLOWED_USERS=
GATEWAY_ALLOW_ALL_USERS=true
# Operators: the only member IDs that may run Hermes slash commands. Must not be empty.
SLACK_ADMIN_USERS=U0000000009
# Optional. Hermes' home channel for its restart notices: a channel only the operators are in.
SLACK_HOME_CHANNEL=
# The workspace URL, for thread permalinks.
SLACK_WORKSPACE_URL=https://example.slack.com
