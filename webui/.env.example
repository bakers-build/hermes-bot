# The local Hermes WebUI look (webui/compose.yaml, README.md › Look at it in Hermes WebUI).
# Copy to webui/.env and fill in. Docker Compose reads the first block for the compose file;
# both containers get every key. For this machine only: the web UI has no sign-in.

# The compose file's own values.
# The bot image the look runs; after changing it: docker compose -f webui/compose.yaml down -v.
PM_BOT_IMAGE=ghcr.io/bakers-build/hermes-bot:main
# A clone of the project's repository, mounted read-only (absolute path).
PM_BOT_CLONE=/path/to/a/clone/of/the/project

# The bot's env, as in .env.example.
HERMES_HOME=/opt/data
PM_BOT_CLONE_DIR=/opt/clone
# Model: an Anthropic API key or a Claude subscription token, exactly one.
PM_BOT_MODEL=claude-sonnet-5-5
PM_BOT_MODEL_BASE_URL=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
PM_BOT_LANGUAGE=de
# bakers.build: a service account's API key and a sandbox project. The bot really creates tickets there.
BAKERS_URL=https://app.bakers.build
BAKERS_API_KEY=
PM_BOT_PROJECT=
PM_BOT_TICKET_WORKFLOW=bb_work
PM_BOT_CONDUCTOR=
# No nightly audit job in the look's Hermes home.
AUDIT_ENABLED=false
TZ=Europe/Berlin

# Slack: inert. `entrypoint.sh check` requires the keys; nothing connects to Slack.
SLACK_BOT_TOKEN=xoxb-inert
SLACK_APP_TOKEN=xapp-inert
SLACK_ALLOWED_CHANNELS=C0000000000
SLACK_ADMIN_USERS=U0000000000
SLACK_WORKSPACE_URL=https://slack.invalid
